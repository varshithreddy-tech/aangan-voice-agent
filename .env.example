# Copy the names into .env (local) and Vercel → Settings → Environment Variables. Never commit values.

# Neon (already in .env)
NEON_DATABASE_URL=
NEON_TEST_DATABASE_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal

# Vaani → our webhooks (shared secret, any long random string)
VAANI_API_KEY=
WEBHOOK_SECRET=

# Cal.com (cloud)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_SITE_VISIT=
CALCOM_EVENT_TYPE_STUDIO=
# Only used if Cal.com insists on an attendee email
CALCOM_PLACEHOLDER_EMAIL_DOMAIN=example.com

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_NIKHIL_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# HubSpot (IDs printed by `npm run hubspot:setup`)
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_ID=
HUBSPOT_FOLLOWUP_STAGE_ID=
HUBSPOT_CONTACTED_STAGE_ID=

# Cron (Vercel sends it as a Bearer token)
CRON_SECRET=

# Cost per unit, in ₹, for the dashboard
VOICE_COST_PER_MIN_INR=
GEMINI_COST_PER_1K_TOKENS_INR=

# Dashboard: no login (decided 2026-10-10)
# Optional: public URL used in transcript links (defaults to the Vercel production URL)
APP_URL=
